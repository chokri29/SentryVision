# Sentry Vision — copy to .env and fill in real values. Never commit .env.
# Baseten Model APIs (Meta Global AI Developer Hackathon).
#
# Official hackathon values from Baseten email:
#   base_url = https://inference.baseten.co/v1
#   model    = meta-models/muse-spark-open-1026
# Your key only works with that model slug (not the public docs slug).

LLM_API_KEY=your_baseten_api_key
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026

# Optional tuning
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# Muse Spark Open does not fully support JSON mode — keep false
LLM_JSON_MODE=false

# Optional CORS (comma-separated). Use * for simple public demos.
ALLOWED_ORIGINS=http://localhost:8000
