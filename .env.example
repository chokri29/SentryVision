# Baseten / OpenAI-compatible Muse Spark
LLM_API_KEY=
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026
# Optional aliases
# LLM_MODEL_ID=meta-models/muse-spark-open-1026

LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120
# Keep false unless the provider is confirmed to support response_format=json_object.
# Enabling this on Muse Spark can cause empty or rejected responses.
LLM_JSON_MODE=false

# Optional F2 self-heal retry: Muse Wonder through Meta Model API.
# This provider uses its OWN key; never reuse the Baseten LLM_API_KEY here.
# When configured, retry requests go to Meta directly, independently of F2.
LLM_RETRY_API_KEY=
LLM_RETRY_BASE_URL=https://api.meta.ai/v1
LLM_RETRY_MODEL=muse-wonder-1.0
LLM_RETRY_TIMEOUT_SECONDS=90

# F1 — deterministic Slither (set true in Docker / when solc+slither are installed)
ENABLE_SLITHER=true
# Cap F3 Slither re-checks per request (each is expensive)
MAX_PATCH_VERIFICATIONS=3
# Max user-triggered patch retries per analysis_id (server-enforced)
MAX_PATCH_RETRIES=1
# Shared Redis storage keeps retry state across Render restarts/workers (use rediss:// in production)
REDIS_URL=
ANALYSIS_TTL_SECONDS=3600
# Require Redis in production; local development may use in-process fallback
REQUIRE_SHARED_STORAGE=false
REQUIRE_REDIS_RATE_LIMIT=false
# Distributed AI usage budget across all workers (analysis + retry requests)
MAX_DAILY_AI_CALLS=100
# Render's edge sets CF-Connecting-IP; only trust it when deployed behind that edge
TRUST_CF_CONNECTING_IP=true
# Optional dedicated HMAC key for pseudonymizing client IPs in Redis keys
RATE_LIMIT_HMAC_KEY=
SLITHER_TIMEOUT_SECONDS=120

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

PORT=8000
